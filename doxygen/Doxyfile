# The Doxygen settings of the site: the settings of ginnOS
# (tools/docs/Doxyfile), with the theme of the site and the output folder.
# doxygen/build.sh runs Doxygen with these settings and sets SITE to the
# site folder. It also makes the header that HTML_HEADER names.

@INCLUDE               = tools/docs/Doxyfile

OUTPUT_DIRECTORY       = $(SITE)/build/doxygen
HTML_EXTRA_STYLESHEET  = $(SITE)/theme/doxygen/doxygen-awesome.css \
                         $(SITE)/theme/doxygen/doxygen-awesome-sidebar-only.css \
                         $(SITE)/theme/doxygen/ginnos.css
WARN_LOGFILE           = $(SITE)/build/doxygen/warnings.txt
HTML_HEADER            = $(SITE)/build/doxygen/header.html
